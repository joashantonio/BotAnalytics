CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Override SQLite location so a Docker volume persists data across restarts.
# Local dev leaves this unset -> backend/trade_handler.db.
# DB_PATH=/data/trade_handler.db

# Log level: DEBUG | INFO | WARNING | ERROR (default INFO).
# LOG_LEVEL=INFO
# Max upload size in bytes (default 25 MB). Keep <= nginx client_max_body_size.
# MAX_UPLOAD_BYTES=26214400
# In-memory parsed-session LRU cap (default 32). Evicted sessions re-parse from DB.
# SESSION_CACHE_MAX=32
# yfinance HTTP fetch timeout in seconds (default 20).
# YF_TIMEOUT=20
